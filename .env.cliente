# Legaliz.ai — Configuração do Servidor do Cliente
# Copie para .env e ajuste as credenciais. Os valores abaixo são PLACEHOLDER e o
# setup.sh recusa subir o sistema com eles (senha de banco, de admin e chave de
# sessão precisam ser reais e próprias deste cliente).

POSTGRES_USER=user
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=legal_db
DATABASE_URL=postgresql://user:troque-esta-senha@db:5432/legal_db

# Admin inicial (criado por init_admin.py no setup; mínimo 8 caracteres).
ADMIN_EMAIL=admin@legaliz.ai
ADMIN_PASSWORD=troque-esta-senha-tambem

# Segredo de assinatura do cookie de sessão (JWT/HS256). SEM ela o app não sobe:
# com um valor público, qualquer pessoa forja um cookie de admin.
# Gere UMA por cliente com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Trocar depois invalida as sessões ativas (todos refazem login).
COOKIE_KEY=troque-esta-chave-por-uma-gerada

OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=phi4-mini:3.8b
LLM_NUM_CTX=8192
TEMPERATURE=0.1
SIMILARITY_THRESHOLD=0.80
TOP_K=15

# Forçar nome da GPU no painel admin (opcional — se não definido, mostra genérico)
# GPU_NAME=NVIDIA GeForce RTX 5060 Ti

# Porta exposta do Streamlit (opcional, padrão 8501)
# STREAMLIT_SERVER_PORT=8501