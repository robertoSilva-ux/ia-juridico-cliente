# Database
DATABASE_URL=postgresql://user:***@db:5432/legal_db
POSTGRES_USER=user
POSTGRES_PASSWORD=***
POSTGRES_DB=legal_db
DB_POOL_MIN=1
DB_POOL_MAX=10

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=nomic-embed-text

# LLM (produção definida pela bancada 2026-09-12: docs/plano_melhoria_modelo_prompt_recuperacao.md)
LLM_MODEL=phi4-mini:3.8b
LLM_NUM_CTX=8192
TEMPERATURE=0.1
SIMILARITY_THRESHOLD=0.80
TOP_K=5
MAX_CONTEXT_CHARS=12000

# Encryption (gerar com: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# Streamlit
STREAMLIT_SERVER_PORT=8501

# Admin (primeira execução)
ADMIN_EMAIL=admin@legaliz.ai
ADMIN_PASSWORD=